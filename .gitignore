!results/phase2-nominal-fpr/mechanism-summary.json
!results/phase2-nominal-fpr/repetition-length.json
!results/phase2-nominal-fpr/null-texts.csv
!results/phase2-nominal-fpr/null-scores.csv.gz

!results/phase2-human-null/human-vs-model-cells.csv
